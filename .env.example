# ==========================================
# CodeReady Environment Configuration
# ==========================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------
# Supabase Configuration
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------
# Razorpay Configuration (Payments in INR)
# ------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ------------------------------------------
# AI Tutor LLM Configuration
# ------------------------------------------
# Supported providers: gemini, openai, mock (default fallback if unconfigured)
LLM_PROVIDER=mock
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# ------------------------------------------
# Admin Bootstrap Configuration
# ------------------------------------------
# Provide comma-separated list of admin emails
ADMIN_EMAILS=admin@codeready.health,lead_coder@codeready.health

# ------------------------------------------
# Analytics (PostHog / Telemetry)
# ------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=phc_optional_token
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
